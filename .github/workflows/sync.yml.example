# Optional: keep domains.json in sync with a running domainer instance.
#
# Rename to sync.yml and set repo secrets:
#   DOMAINER_URL    e.g. https://your-host:7777/api/portfolio?owner=123456789
#   DOMAINER_TOKEN  the HTTP_API_TOKEN you configured in domainer (optional)
#
# domainer ships an HTTP server (npm run start:server) exposing
# GET /api/portfolio. This workflow pulls it on a schedule, rewrites
# domains.json, and commits if anything changed. Pages redeploys on push.

name: Sync from domainer

on:
  schedule:
    - cron: "0 */6 * * *" # every 6 hours
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Pull portfolio from domainer
        env:
          DOMAINER_URL: ${{ secrets.DOMAINER_URL }}
          DOMAINER_TOKEN: ${{ secrets.DOMAINER_TOKEN }}
        run: |
          curl -fsSL \
            ${DOMAINER_TOKEN:+-H "Authorization: Bearer $DOMAINER_TOKEN"} \
            "$DOMAINER_URL" > .domainer.json

          # Map domainer's export shape → domains.json schema.
          # Keep the existing "owner" block; replace "domains".
          node -e '
            const fs = require("fs");
            const cur = JSON.parse(fs.readFileSync("domains.json", "utf8"));
            const src = JSON.parse(fs.readFileSync(".domainer.json", "utf8"));
            const rows = Array.isArray(src) ? src : (src.domains || []);
            cur.domains = rows.map(r => ({
              name: r.name,
              bin: r.bin ?? null,
              tags: (r.tags || (r.category ? [r.category] : [])),
              status: r.status === "sold" ? "sold"
                    : r.bin ? "for_sale" : "active"
            }));
            fs.writeFileSync("domains.json", JSON.stringify(cur, null, 2) + "\n");
          '
          rm -f .domainer.json

      - name: Commit if changed
        run: |
          if ! git diff --quiet domains.json; then
            git config user.name  "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add domains.json
            git commit -m "chore: sync portfolio from domainer"
            git push
          else
            echo "No changes."
          fi
