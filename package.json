{
  "name": "open-domain",
  "version": "0.1.0",
  "description": "Open-Domain — authoritative wildcard-IP DNS server (ala nip.io/sslip.io) buat a-i.st + a-i.sh, zero dependency.",
  "type": "module",
  "bin": {
    "open-domain": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "PORT=5353 BIND=127.0.0.1 DEBUG=1 node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "monitor": "node monitor/check.js",
    "monitor:test": "node --test monitor/production.test.js",
    "monitor:remote": "./monitor/remote.sh",
    "capability": "node monitor/capability.js",
    "stats": "node monitor/stats.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
