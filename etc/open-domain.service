# systemd unit for the authoritative DNS server.
# Deployed to /etc/systemd/system/open-domain.service on the nameserver.
#
# Machine-specific values (the addresses to bind and answer) live in
# /etc/default/open-domain, not here — see open-domain.default.example. This unit is
# deliberately server-agnostic so moving to another VPS only touches that one file.

[Unit]
Description=Open-Domain — authoritative wildcard-IP DNS (a-i.sh, a-i.st)
Documentation=https://github.com/kwkuh/open-domain
After=network-online.target
Wants=network-online.target

# Do NOT give up restarting. The default StartLimit gives up after 5 restarts in 10
# seconds and leaves the unit dead — so a transient boot-time failure (IPv6 not up
# yet, a port still held during a fast restart) would take DNS down permanently with
# nobody restarting it. For the one service this whole project exists to provide,
# "keep trying forever" is the correct policy. RestartSec spaces the attempts out so
# a genuine crash-loop does not spin the CPU.
StartLimitIntervalSec=0

[Service]
Type=simple
User=opendomain
Group=nogroup
WorkingDirectory=/opt/open-domain
ExecStart=/usr/bin/node /opt/open-domain/src/server.js
EnvironmentFile=-/etc/default/open-domain
Restart=always
RestartSec=2

# Bind port 53 (below 1024) without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The process reads its own code and writes only the query log.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/log/open-domain

[Install]
WantedBy=multi-user.target
